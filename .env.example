# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (hackathon sandbox cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
CAPY_DB=capybarrier

# Voyage AI through MongoDB Atlas (Model API key, starts with al-)
VOYAGE_API_KEY=al-...
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
EMBED_MODEL=voyage-4-lite

# Any OpenAI compatible LLM endpoint (W&B Inference shown)
LLM_BASE_URL=https://api.inference.wandb.ai/v1
LLM_API_KEY=wandb_v1_...
AGENT_MODEL=google/gemma-4-26B-A4B-it
EVOLVER_MODEL=Qwen/Qwen3.8-27B

# Atlas Agent Engine (optional, for pushing guardrails/policies and self redeploys)
AGENTENGINE_BASE_URL=https://agentengine.mongodb.com/api/v1
AGENTENGINE_CLIENT_ID=ae_sa_id_...
AGENTENGINE_CLIENT_SECRET=ae_sa_sk_...
AGENTENGINE_PROJECT_ID=...
AGENTENGINE_WORKSPACE_ID=

# Raindrop (optional): the write key sends every episode, candidate and production request with signals;
# the Query API key lets the evolver pull production requests Raindrop flagged back in as training cases.
RAINDROP_WRITE_KEY=
RAINDROP_QUERY_API_KEY=

# ElevenLabs (only used to narrate the demo video)
ELEVENLABS_API_KEY=sk_...

CAPY_CONCURRENCY=8
